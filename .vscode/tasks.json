{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "项目：运行测试",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "YOLO_CONFIG_DIR": "${workspaceFolder}/.tools/ultralytics",
          "MPLCONFIGDIR": "${workspaceFolder}/.tools/matplotlib"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "项目：检查依赖",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
